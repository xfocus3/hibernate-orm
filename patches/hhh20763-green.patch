diff --git a/hibernate-core/src/test/java/org/hibernate/orm/test/constraint/XmlOverrideDefaultForeignKeyTest.java b/hibernate-core/src/test/java/org/hibernate/orm/test/constraint/XmlOverrideDefaultForeignKeyTest.java
