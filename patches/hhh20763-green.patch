diff --git a/hibernate-core/src/test/java/org/hibernate/boot/model/internal/PrimaryKeyJoinColumnForeignKeyResolverTest.java b/hibernate-core/src/test/java/org/hibernate/boot/model/internal/PrimaryKeyJoinColumnForeignKeyResolverTest.java
