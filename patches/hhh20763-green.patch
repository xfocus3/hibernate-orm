--- /dev/null
+++ b/hibernate-core/src/test/java/org/hibernate/orm/test/constraint/XmlOverrideDefaultForeignKeyTest.java
@@ -0,0 +1,93 @@
+package org.hibernate.orm.test.constraint;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+
+import org.hibernate.boot.MetadataSources;
+import org.hibernate.boot.registry.StandardServiceRegistryBuilder;
+import org.hibernate.dialect.H2Dialect;
+
+import org.hibernate.testing.orm.junit.JiraKey;
+import org.hibernate.testing.orm.junit.RequiresDialect;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+
+import jakarta.persistence.Entity;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.MappedSuperclass;
+import jakarta.persistence.OneToOne;
+import jakarta.persistence.Table;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@JiraKey("HHH-20763")
+@RequiresDialect(H2Dialect.class)
+class XmlOverrideDefaultForeignKeyTest {
+	@ParameterizedTest
+	@CsvSource({
+			"NO_CONSTRAINT, omitted, false",
+			"CONSTRAINT, omitted, true",
+			"NO_CONSTRAINT, CONSTRAINT, true",
+			"CONSTRAINT, NO_CONSTRAINT, false"
+	})
+	void xmlOverrideRespectsConstraintMode(String defaultMode, String overrideMode, boolean expectedKey) {
+		final String foreignKey = overrideMode.equals( "omitted" ) ? ""
+				: "<foreign-key constraint-mode=\"" + overrideMode + "\"/>";
+		final String xml = """
+				<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.2">
+				    <entity class="%s" access="FIELD">
+				        <association-override name="target">
+				            <join-column name="id" insertable="false" updatable="false"/>
+				            %s
+				        </association-override>
+				    </entity>
+				</entity-mappings>
+				""".formatted( Owner.class.getName(), foreignKey );
+		final var registry = new StandardServiceRegistryBuilder()
+				.applySetting( "hibernate.connection.url", "jdbc:h2:mem:xml_override_fk" )
+				.applySetting( "hibernate.hbm2ddl.auto", "create-drop" )
+				.applySetting( "hibernate.hbm2ddl.default_constraint_mode", defaultMode )
+				.build();
+		try {
+			final var metadata = new MetadataSources( registry )
+					.addAnnotatedClass( Owner.class )
+					.addAnnotatedClass( Target.class )
+					.addInputStream( new ByteArrayInputStream( xml.getBytes( StandardCharsets.UTF_8 ) ) )
+					.buildMetadata();
+			try ( var factory = metadata.buildSessionFactory() ) {
+				factory.inSession( session -> session.doWork( connection -> {
+					try ( var keys = connection.getMetaData().getImportedKeys( null, null, "XML_OVERRIDE_OWNER" ) ) {
+						assertThat( keys.next() ).isEqualTo( expectedKey );
+						assertThat( keys.next() ).isFalse();
+					}
+				} ) );
+			}
+		}
+		finally {
+			StandardServiceRegistryBuilder.destroy( registry );
+		}
+	}
+
+	@MappedSuperclass
+	static class OwnerBase {
+		@Id
+		int id;
+
+		@OneToOne(optional = false)
+		@JoinColumn(name = "id", insertable = false, updatable = false)
+		Target target;
+	}
+
+	@Entity
+	@Table(name = "xml_override_owner")
+	static class Owner extends OwnerBase {
+	}
+
+	@Entity
+	@Table(name = "xml_override_target")
+	static class Target {
+		@Id
+		int id;
+	}
+}
